APP_NAME="autism_chat_bot"
APP_VERSION="0.1"
FILE_ALLOWED_EXTENSION=["tex/plain","application/pdf","application/epub+zip"]
CHUNK_SIZE=512000
# هنا هو بيقول عشان الفايل يترفع لازم يتقسم لشانكس عشان مش فايل واحد يملا التيمبوريري  فهنقسم لشانكس بالبايت
MONGO_URL="mongodb://localhost:27007"
MONGO_DATABASE="Autism_chat_bot"

######## LLM CONFIG ######################

GENERATION_BACK_END="COHERE"
EMBEDDING_BACK_END="COHERE"

OPENAI_API_KEY=""
OPEN_API_URL=""
COHERE_API_KEY=""

GENERATION_MODEL_ID="command-a-03-2025"
EMBEDDING_MODEL_ID="embed-multilingual-v3.0"

EMBEDDING_MODEL_SIZE=1024

GENERATION_DEFAULT_MAX_TOKENS=1000
INPUT_DEFAULT_MAX_CHARACTERS=1024
GENERATION_DEFAULT_MAX_CHARACTERS=1024
TEMPRETURE=0.5


VECTOR_DB_BACKEND="QDRANT"
VECTOR_DB_PATH_="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"

DEFAULT_LANGUAGE="arabic"
LANGUAGE="english"

#_____________________postgres______________
